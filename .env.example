# ─── LandChain Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local dev:   mongodb://localhost:27017/landchain
# Production:  mongodb+srv://USER:PASS@cluster.mongodb.net/landchain
MONGODB_URI=mongodb://localhost:27017/landchain

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES=8h

# ── Blockchain ────────────────────────────────────────────────────────────────
# Local Hardhat node:  http://127.0.0.1:8545
# Sepolia testnet:     https://sepolia.infura.io/v3/YOUR_INFURA_KEY
RPC_URL=http://127.0.0.1:8545

# Backend system wallet private key (Hardhat default account #0 for dev)
# NEVER use a real private key in development
BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia deployment (only needed for testnet deployment)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
PRIVATE_KEY=your-deployer-wallet-private-key

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your-etherscan-api-key

# ── Africa's Talking SMS ──────────────────────────────────────────────────────
# Sign up free at: https://africastalking.com
# Use "sandbox" for development, real keys for production
AT_API_KEY=sandbox
AT_USERNAME=sandbox

# ── Google Maps API ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── File Storage (for survey documents) ──────────────────────────────────────
# Using local storage for dev. Switch to AWS S3 or IPFS for production.
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=landchain-documents

# ── IPFS (for NFT metadata) ───────────────────────────────────────────────────
# Sign up at: https://app.pinata.cloud
# PINATA_API_KEY=your-pinata-key
# PINATA_SECRET_KEY=your-pinata-secret
